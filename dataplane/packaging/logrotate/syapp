/var/log/syapp/*.log /var/log/syapp/*.json /var/log/syapp-*/*.log /var/log/syapp-*/*.json {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        # 默认实例与所有具名实例（syapp-instance add 创建）都重新打开日志
        if [ -x /usr/sbin/syapp-instance ]; then
            /usr/sbin/syapp-instance reopen-all >/dev/null 2>&1 || true
        else
            /opt/syapp/sbin/syapp -s reopen >/dev/null 2>&1 || true
        fi
    endscript
}
