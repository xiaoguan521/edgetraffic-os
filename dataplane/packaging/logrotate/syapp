/var/log/syapp/*.log /var/log/syapp/*.json /var/log/syapp-*/*.log /var/log/syapp-*/*.json {
    daily
    # 日志目录属于数据面用户（运行时不使用 root）：以该用户轮转，postrotate 中的 reopen 也以该用户执行
    su syapp syapp
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        # 默认实例与所有具名实例（syapp-instance add 创建）都重新打开日志
        if [ -x /usr/sbin/syapp-instance ]; then
            runuser -u syapp -- /usr/sbin/syapp-instance reopen-all >/dev/null 2>&1 || true
        else
            runuser -u syapp -- /opt/syapp/sbin/syapp -s reopen >/dev/null 2>&1 || true
        fi
    endscript
}
