/var/log/syedge/*.log /var/log/syedge/*.json /var/log/syedge-*/*.log /var/log/syedge-*/*.json {
    daily
    # 日志目录属于数据面用户（运行时不使用 root）：以该用户轮转，postrotate 中的 reopen 也以该用户执行
    su syedge syedge
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        # 默认实例与所有具名实例（syedge-instance add 创建）都重新打开日志
        if [ -x /usr/sbin/syedge-instance ]; then
            runuser -u syedge -- /usr/sbin/syedge-instance reopen-all >/dev/null 2>&1 || true
        else
            runuser -u syedge -- /opt/syedge/sbin/syedge -s reopen >/dev/null 2>&1 || true
        fi
    endscript
}
