/opt/syedge/logs/*.log /opt/syedge/logs/*.json /opt/syedge/instances/*/logs/*.log /opt/syedge/instances/*/logs/*.json {
    daily
    # 日志目录属于数据面用户：以该用户轮转（兼容模式下 root master 新建的日志同样在该目录中）
    su syedge syedge
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        # 默认实例与所有具名实例（syedge-instance add 创建）都重新打开日志
        # syedge-instance 以 root 执行时自行决定发信号的身份：默认以 syedge（master 不是 root），
        # 兼容模式（master 以 root 运行，与传统 Web 服务器相同）以 root
        if [ -x /usr/sbin/syedge-instance ]; then
            /usr/sbin/syedge-instance reopen-all >/dev/null 2>&1 || true
        elif [ -f /etc/syedge/root-master ]; then
            /opt/syedge/sbin/syedge -p /opt/syedge -s reopen >/dev/null 2>&1 || true
        else
            runuser -u syedge -- /opt/syedge/sbin/syedge -p /opt/syedge -s reopen >/dev/null 2>&1 || true
        fi
    endscript
}
