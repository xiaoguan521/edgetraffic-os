#!/usr/bin/env bash
# syapp-firewall：边缘节点可选的 nftables 入站防火墙（规格书 P6-6）。默认不启用。
#
#   syapp-firewall enable --ssh-from 10.0.0.0/8,203.0.113.5 [--ssh-port 22] [--allow-tcp 9100] [--allow-udp 443] [--force]
#   syapp-firewall disable
#   syapp-firewall status
#   syapp-firewall refresh      按本机实例的当前配置重新生成规则（未启用时什么都不做）
#
# 启用后：所有来源可访问本机全部实例当前配置中对外监听的端口（各实例的 HTTP/HTTPS 与四层代理端口；
# 读不到实例配置时为 80/443），以及 --allow-tcp/--allow-udp；SSH 只对 --ssh-from 开放，其余入站丢弃；出站不限制。
# 实例增删（syapp-instance）与每次发布（syapp-firewall-refresh.path 监视各实例的配置目录）后自动 refresh。
# 规则只在独立的表 inet syapp_fw 中，不修改其他表；开机由 syapp-firewall.service 加载。
set -euo pipefail
RULES=${SYAPP_FW_RULES:-/etc/syapp/firewall.nft}
ARGS="$RULES.args"   # enable 的参数（refresh 时沿用）
UNIT=syapp-firewall.service
REFRESH=syapp-firewall-refresh.path
AGENT=${SYAPP_AGENT:-/usr/bin/syapp-agent}
NFT=${SYAPP_NFT:-nft}
SYSTEMCTL=${SYAPP_SYSTEMCTL:-systemctl}   # 测试时替换为 true

die() { echo "syapp-firewall: $*" >&2; exit 1; }
usage() { sed -n '4,7p' "$0" | sed 's/^# \{0,3\}//'; exit 2; }

# load <规则文件>：校验后原子替换并加载
load() {
  "$NFT" -c -f "$1" || die "nft 校验失败"
  install -o root -g root -m 0600 -D "$1" "$RULES.new"
  mv -f "$RULES.new" "$RULES"
  "$NFT" -f "$RULES"
}

cmd=${1:-}; [[ -n "$cmd" ]] || usage; shift
case "$cmd" in
  enable)
    from=""; port=22; tcp=""; udp=""; force=0; anyssh=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --ssh-from)      from="$2"; shift 2 ;;
        --ssh-port)      port="$2"; shift 2 ;;
        --allow-tcp)     tcp="$2";  shift 2 ;;
        --allow-udp)     udp="$2";  shift 2 ;;
        --allow-any-ssh) anyssh=(-allow-any-ssh); shift ;;
        --force)         force=1; shift ;;
        *) die "未知参数：$1" ;;
      esac
    done
    [[ $EUID -eq 0 ]] || die "请以 root 运行"
    command -v "$NFT" >/dev/null || die "未找到 nft（dnf install nftables / apt install nftables）"
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    saved=(-ssh-from "$from" -ssh-port "$port" -allow-tcp "$tcp" -allow-udp "$udp" ${anyssh[@]+"${anyssh[@]}"})
    "$AGENT" firewall render "${saved[@]}" -instances > "$tmp" \
      || die "参数无效（见上）"
    # 防止把自己锁在外面：当前 SSH 会话的来源必须在 --ssh-from 中
    client=${SSH_CONNECTION:-}; client=${client%% *}
    if [[ -n "${SSH_CONNECTION:-}" && $force -eq 0 ]]; then
      if ! "$AGENT" firewall covers -ssh-from "$from" -ip "$client"; then
        die "当前 SSH 会话来自 $client，不在 --ssh-from 中，启用后会断开。请把它加入 --ssh-from，或确认后加 --force"
      fi
    fi
    for svc in firewalld ufw; do
      if $SYSTEMCTL is-active -q "$svc" 2>/dev/null; then
        echo "警告：$svc 正在运行。nftables 中任一表丢弃的包都会被丢弃，$svc 的规则仍然生效，需要同时在 $svc 中放行业务端口。" >&2
      fi
    done
    load "$tmp"
    install -o root -g root -m 0600 /dev/null "$ARGS"
    printf '%s\n' "${saved[@]}" > "$ARGS"
    $SYSTEMCTL daemon-reload
    $SYSTEMCTL enable "$UNIT" >/dev/null 2>&1
    $SYSTEMCTL start "$UNIT"   # oneshot + RemainAfterExit：标记为已启用，规则已在上一步加载
    $SYSTEMCTL enable --now "$REFRESH" >/dev/null 2>&1 || true
    open=$(grep -E '^\s*(tcp|udp) dport \{' "$RULES" | sed -E 's/^\s*(tcp|udp) dport \{ (.*) \} accept/\1 \2/' | awk 'NR > 1 { printf "；" } { printf "%s", $0 }')
    echo "已启用：对所有来源开放 ${open:-无}；SSH($port) 仅允许 $from"
    ;;
  refresh)
    [[ $EUID -eq 0 ]] || die "请以 root 运行"
    if [[ ! -f "$ARGS" ]] || ! "$NFT" list table inet syapp_fw >/dev/null 2>&1; then
      echo "防火墙未启用，无需刷新"; exit 0
    fi
    mapfile -t saved < "$ARGS"
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    # 生成失败（例如某个实例改为监听 SSH 端口）时保留现有规则
    "$AGENT" firewall render "${saved[@]}" -instances > "$tmp" || die "生成规则失败，现有规则保持不变"
    if cmp -s "$tmp" "$RULES"; then echo "规则无变化"; exit 0; fi
    load "$tmp"
    echo "已按实例配置刷新规则"
    ;;
  disable)
    [[ $EUID -eq 0 ]] || die "请以 root 运行"
    $SYSTEMCTL disable --now "$REFRESH" >/dev/null 2>&1 || true
    $SYSTEMCTL disable --now "$UNIT" >/dev/null 2>&1 || true
    "$NFT" delete table inet syapp_fw 2>/dev/null || true
    echo "已停用，规则已移除（$RULES 保留，可再次 enable）"
    ;;
  status)
    if "$NFT" list table inet syapp_fw 2>/dev/null; then
      echo "状态：已启用（开机加载：$($SYSTEMCTL is-enabled "$UNIT" 2>/dev/null || echo 否)）"
    else
      echo "状态：未启用"
    fi
    ;;
  *) usage ;;
esac
