[Unit]
Description=syapp edge firewall (nftables table inet syapp_fw)
Documentation=man:nft(8)
DefaultDependencies=no
Before=network-pre.target syapp.service
Wants=network-pre.target
ConditionPathExists=/var/lib/syapp-firewall/firewall.nft

[Service]
Type=oneshot
RemainAfterExit=yes
# 运行时不使用 root（设计 0001 D5）：防火墙专用用户，只带 CAP_NET_ADMIN；规则文件属于该用户（syapp-firewall enable 写入）
User=syapp-firewall
Group=syapp-firewall
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ExecStart=/usr/sbin/nft -f /var/lib/syapp-firewall/firewall.nft
ExecReload=/usr/sbin/nft -f /var/lib/syapp-firewall/firewall.nft
ExecStop=-/usr/sbin/nft delete table inet syapp_fw

[Install]
WantedBy=multi-user.target
