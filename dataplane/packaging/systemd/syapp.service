[Unit]
Description=EdgeTraffic OS data plane (syapp)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
# 运行时不使用 root（设计 0001 第 6.1 节方式 B，D5）：master 与 worker 都以 syapp 运行，只带绑定 80/443 的能力；
# 能力为 ambient，二进制热升级（USR2 重新执行）后的新 master 同样保留
User=syapp
Group=syapp
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PIDFile=/run/syapp/syapp.pid
RuntimeDirectory=syapp
# 停止服务时保留 /run/syapp，管理员随后手工执行 syapp -t 不会因缺少 pid 目录失败
RuntimeDirectoryPreserve=yes
ExecStartPre=/opt/syapp/sbin/syapp -t -q
ExecStart=/opt/syapp/sbin/syapp
ExecReload=/opt/syapp/sbin/syapp -s reload
ExecStop=/opt/syapp/sbin/syapp -s quit
LimitNOFILE=65535
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
