[Unit]
Description=syapp firewall: refresh rules from instance configurations
ConditionPathExists=/var/lib/syapp-firewall/firewall.nft.args

[Service]
Type=oneshot
# 运行时不使用 root（设计 0001 D5）：防火墙专用用户，只带 CAP_NET_ADMIN；只读各实例的配置
User=syapp-firewall
Group=syapp-firewall
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ExecStart=/usr/sbin/syapp-firewall refresh
