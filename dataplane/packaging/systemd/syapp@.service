[Unit]
Description=EdgeTraffic OS data plane (syapp instance %i)
After=network-online.target
Wants=network-online.target
# 只能启动由 syapp-instance add 创建的实例（设计 0001 第 5.7 节）
ConditionPathExists=/opt/syapp/instances/%i/instance.json

[Service]
Type=forking
# 运行时不使用 root（设计 0001 第 6.1 节方式 B，D5）：master 与 worker 都以 syapp 运行，只带绑定 80/443 的能力；
# 能力为 ambient，二进制热升级（USR2 重新执行）后的新 master 同样保留
User=syapp
Group=syapp
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# 配置中的 pid、日志与临时目录由控制台按节点组实例档案渲染为本实例的路径
PIDFile=/run/syapp-%i/syapp.pid
RuntimeDirectory=syapp-%i
RuntimeDirectoryPreserve=yes
ExecStartPre=/opt/syapp/sbin/syapp -t -q -c /opt/syapp/instances/%i/conf/current/syapp.conf
ExecStart=/opt/syapp/sbin/syapp -c /opt/syapp/instances/%i/conf/current/syapp.conf
ExecReload=/opt/syapp/sbin/syapp -c /opt/syapp/instances/%i/conf/current/syapp.conf -s reload
ExecStop=/opt/syapp/sbin/syapp -c /opt/syapp/instances/%i/conf/current/syapp.conf -s quit
LimitNOFILE=65535
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
