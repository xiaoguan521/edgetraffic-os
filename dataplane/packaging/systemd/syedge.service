[Unit]
Description=SyEdge data plane (syedge)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
# 运行时不使用 root（设计 0001 第 6.1 节方式 B，D5）：master 与 worker 都以 syedge 运行，只带绑定 80/443 的能力；
# 能力为 ambient，二进制热升级（USR2 重新执行）后的新 master 同样保留
User=syedge
Group=syedge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# pid、日志、临时目录都在实例前缀下（run/、logs/、cache/），由安装程序创建并交给 syedge 用户；
# 数据面的默认配置、pid、日志编译为相对 -p 的路径，因此手工执行 syedge -p <前缀> -t / -s reload 不需要 -c、-e
PIDFile=/opt/syedge/run/syedge.pid
ExecStartPre=/opt/syedge/sbin/syedge -p /opt/syedge -t -q
ExecStart=/opt/syedge/sbin/syedge -p /opt/syedge
ExecReload=/opt/syedge/sbin/syedge -p /opt/syedge -s reload
ExecStop=/opt/syedge/sbin/syedge -p /opt/syedge -s quit
# ExecStop 发出 QUIT 后立即返回；systemd 后续也必须让 master 优雅停止，而非向所有 worker 发送 TERM。
KillMode=mixed
KillSignal=SIGQUIT
LimitNOFILE=65535
PrivateTmp=true
ProtectHome=true
# 二进制、动态模块与版本库对本服务只读：worker 与 master 同一用户，被攻破的 worker 不能替换 master 之后（reload 加载模块、
# 热升级执行新二进制）会用到的文件。升级由单元之外的 wrapper 写入，不受影响；前缀 - 表示目录不存在时忽略。
# 老版 systemd（如 CentOS 7）不识别该指令，会忽略它，此时仍靠目录属主（兼容模式为 root）保护。
ReadOnlyPaths=-/opt/syedge/sbin -/opt/syedge/modules -/opt/syedge/versions

[Install]
WantedBy=multi-user.target
