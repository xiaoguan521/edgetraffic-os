[Unit]
Description=SyEdge data plane (syedge instance %i)
After=network-online.target
Wants=network-online.target
# 只能启动由 syedge-instance add 创建的实例（设计 0001 第 5.7 节）
ConditionPathExists=/opt/syedge/instances/%i/instance.json

[Service]
Type=forking
# 运行时不使用 root（设计 0001 第 6.1 节方式 B，D5）：master 与 worker 都以 syedge 运行，只带绑定 80/443 的能力；
# 能力为 ambient，二进制热升级（USR2 重新执行）后的新 master 同样保留
User=syedge
Group=syedge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# 配置中的 pid、日志与临时目录由控制台按节点组实例档案渲染为本实例的路径
PIDFile=/run/syedge-%i/syedge.pid
RuntimeDirectory=syedge-%i
RuntimeDirectoryPreserve=yes
ExecStartPre=/opt/syedge/sbin/syedge -t -q -c /opt/syedge/instances/%i/conf/current/syedge.conf
ExecStart=/opt/syedge/sbin/syedge -c /opt/syedge/instances/%i/conf/current/syedge.conf
ExecReload=/opt/syedge/sbin/syedge -c /opt/syedge/instances/%i/conf/current/syedge.conf -s reload
ExecStop=/opt/syedge/sbin/syedge -c /opt/syedge/instances/%i/conf/current/syedge.conf -s quit
# 与默认实例一致：让 master 等待现有连接结束，再由 systemd 完成停止。
KillMode=mixed
KillSignal=SIGQUIT
LimitNOFILE=65535
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
