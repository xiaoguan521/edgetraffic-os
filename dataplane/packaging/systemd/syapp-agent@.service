[Unit]
Description=EdgeTraffic OS edge agent (syapp-agent instance %i)
After=network-online.target syapp@%i.service
Wants=network-online.target
ConditionPathExists=/opt/syapp/instances/%i/instance.json

[Service]
# 每个实例一个 agent 用户，sudoers 只允许它操作本实例（/etc/sudoers.d/syapp-agent-%i）
User=syapp-agent-%i
Group=syapp
EnvironmentFile=-/etc/syapp-agent/agent-%i.env
# 路径、端口与 wrapper 调用方式由实例名与 /opt/syapp/instances/%i/instance.json 推出
ExecStart=/usr/bin/syapp-agent run -instance %i
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# 经 sudo 调用的 wrapper 与本服务共享挂载命名空间：需要本实例的配置、日志、缓存目录，以及热升级用的共用版本库
ReadWritePaths=/opt/syapp/instances/%i/conf /var/lib/syapp-agent-%i /run/syapp-agent-%i -/run/syapp-%i /var/log/syapp-%i /var/cache/syapp-%i -/run/sudo -/opt/syapp/versions /opt/syapp/sbin
RuntimeDirectory=syapp-agent-%i
StateDirectory=syapp-agent-%i

[Install]
WantedBy=multi-user.target
