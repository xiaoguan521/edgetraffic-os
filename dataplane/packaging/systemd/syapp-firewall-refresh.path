# 发布后（current 软链切换）自动按实例配置刷新防火墙规则（设计 0001 第 5.8 节）。
# 具名实例的配置目录由 syapp-instance 写入 syapp-firewall-refresh.path.d/instances.conf。
[Unit]
Description=syapp firewall: refresh rules when instance configurations change
ConditionPathExists=/var/lib/syapp-firewall/firewall.nft.args

[Path]
PathChanged=/opt/syapp/conf
Unit=syapp-firewall-refresh.service

[Install]
WantedBy=multi-user.target
