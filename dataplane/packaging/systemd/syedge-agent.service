[Unit]
Description=SyEdge edge agent (syedge-agent)
After=network-online.target syedge.service
Wants=network-online.target

[Service]
User=syedge-agent
Group=syedge
EnvironmentFile=-/etc/syedge-agent/agent.env
# 控制台地址默认读取注册时保存的 /var/lib/syedge-agent/node.json，也可在 agent.env 中用 SYEDGE_CONSOLE 覆盖
ExecStart=/usr/bin/syedge-agent run
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# 经 sudo 调用的 syedge-wrapper（syedge -t / -s reload / 热升级）与本服务共享挂载命名空间，需要写日志、缓存目录，
# 以及热升级时的 /opt/syedge/versions 与 /opt/syedge/sbin（目录仍为 root 所有，agent 用户本身没有写权限）
ReadWritePaths=/opt/syedge/conf /var/lib/syedge-agent /run/syedge-agent -/run/syedge /var/log/syedge /var/cache/syedge -/run/sudo -/opt/syedge/versions /opt/syedge/sbin
RuntimeDirectory=syedge-agent
StateDirectory=syedge-agent

[Install]
WantedBy=multi-user.target
