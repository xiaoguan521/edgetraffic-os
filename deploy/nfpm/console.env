# SyEdge 控制台配置。修改后执行：systemctl restart syedge-console
#
# Web 控制台监听地址。生产环境只在内网开放，并配置 TLS。
ETOS_LISTEN=127.0.0.1:8443
# HTTPS：默认由控制台内置的 Web CA 自动签发证书并续期，首次使用时下载 https://<控制台>/web-ca.crt 导入浏览器。
# 使用企业自己的证书时，填写下面两行（优先于自动证书）。
ETOS_TLS_AUTO=1
# ETOS_TLS_CERT=/etc/syedge-console/tls.crt
# ETOS_TLS_KEY=/etc/syedge-console/tls.key
# 自动证书包含的主机名 / IP（默认取 ETOS_GRPC_HOSTS 并加上 localhost）
# ETOS_WEB_HOSTS=

# 节点连接控制台的地址（mTLS）。ETOS_GRPC_HOSTS 写入控制台证书，节点用其中的主机名或 IP 连接，必须填写。
ETOS_GRPC_LISTEN=0.0.0.0:9443
ETOS_GRPC_HOSTS=
# 写入“添加节点”命令的地址，默认取 ETOS_GRPC_HOSTS 的第一个
ETOS_GRPC_ADVERTISE=

# 数据目录（SQLite 数据库、CA、私钥加密密钥）
ETOS_DATA=/var/lib/syedge-console
# 使用 PostgreSQL 时填写，例如 postgres://edgetraffic:密码@127.0.0.1:5432/edgetraffic?sslmode=disable
# ETOS_DB=

# ACME 自动申请证书：默认使用 Let's Encrypt（在“证书”页的 ACME 设置中可改为内网自建的 ACME 服务）。
# 内网 ACME 服务使用私有 CA 时，在这里指定该 CA 的证书：
# ETOS_ACME_CA_FILE=/etc/syedge-console/acme-ca.pem
