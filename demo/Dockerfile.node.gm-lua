# 隔离验收用节点镜像：国密 syedge（gmssl）+ syedge-lua + syedge-agent。
# 该镜像只供 gm-lua Compose 使用，不替换演示环境的标准版 node 镜像。

FROM ubuntu:24.04 AS syedge-lua-build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git make patch perl \
      gzip bzip2 xz-utils tar \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY dataplane dataplane
COPY brand.env brand.env
COPY scripts/rename-scan.sh scripts/rename-scan.sh
COPY docs/NOTICE docs/NOTICE
# 同一次构建产出 gmssl 基础包和与其版本绑定的 syedge-lua 附加包。
RUN bash dataplane/build-syedge-lua.sh -o /out

FROM golang:1.27 AS go
ARG EXTRA_LICENSE_KEY=""
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath \
      -ldflags "-s -w -X github.com/xiaoguan521/edgetraffic-os/internal/license.ciKey=${EXTRA_LICENSE_KEY}" \
      -o /out/ ./cmd/syedge-agent ./cmd/syedge-wrapper

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      libpcre2-8-0 libssl3t64 zlib1g sudo ca-certificates curl procps libcap2-bin \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -r syedge && useradd -r -g syedge -s /usr/sbin/nologin syedge \
 && useradd -r -g syedge -s /usr/sbin/nologin syedge-agent

COPY --from=syedge-lua-build /out/base/syedge-*-gmssl-*.tar.gz /tmp/
RUN tar -C / -xzf /tmp/syedge-*-gmssl-*.tar.gz \
 && rm -f /tmp/syedge-*-gmssl-*.tar.gz \
 && ln -s /opt/syedge/sbin/syedge /usr/sbin/syedge

COPY --from=syedge-lua-build /out/syedge-lua-*.tar.gz /tmp/
RUN mkdir -p /tmp/syedge-lua \
 && tar -C /tmp/syedge-lua -xzf /tmp/syedge-lua-*.tar.gz \
 && bash /tmp/syedge-lua/install.sh \
 && rm -rf /tmp/syedge-lua /tmp/syedge-lua-*.tar.gz

COPY --from=go /out/syedge-agent /usr/bin/syedge-agent
COPY --from=go /out/syedge-wrapper /usr/libexec/syedge/syedge-wrapper
COPY dataplane/packaging/sudoers/syedge-agent /etc/sudoers.d/syedge-agent
# 运行时不使用 root（D5）：wrapper 以 syedge 运行，-t 绑定 80/443 需要文件能力；只允许 syedge 组执行
RUN chown root:syedge /usr/libexec/syedge/syedge-wrapper && chmod 0750 /usr/libexec/syedge/syedge-wrapper \
 && setcap cap_net_bind_service=ip /usr/libexec/syedge/syedge-wrapper
RUN chmod 0440 /etc/sudoers.d/syedge-agent && \
    (visudo -c || (sed -i '/^Defaults:[^[:space:]]* !requiretty$/d' /etc/sudoers.d/syedge-agent && visudo -c))
COPY demo/node/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY demo/node/systemctl /usr/local/bin/systemctl
RUN chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/systemctl
EXPOSE 80 443
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
