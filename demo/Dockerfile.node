# 演示用边缘节点镜像：syedge（从官方源码改名构建）+ syedge-agent + syedge-wrapper
FROM ubuntu:24.04 AS syedge
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git ca-certificates \
      libpcre2-dev libssl-dev zlib1g-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY dataplane dataplane
COPY brand.env brand.env
COPY scripts/rename-scan.sh scripts/rename-scan.sh
COPY docs/NOTICE docs/NOTICE
RUN dataplane/build-syedge.sh -o /out

FROM golang:1.27 AS go
# 仅 CI 端到端测试注入临时授权公钥；正式与演示构建留空
ARG EXTRA_LICENSE_KEY=""
ARG EXTRA_PKG_KEY=""
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath -ldflags "-s -w -X github.com/xiaoguan521/edgetraffic-os/internal/license.ciKey=${EXTRA_LICENSE_KEY} -X github.com/xiaoguan521/edgetraffic-os/internal/pkgsig.ciKey=${EXTRA_PKG_KEY}" -o /out/ ./cmd/syedge-agent ./cmd/syedge-wrapper

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends libpcre2-8-0 libssl3t64 zlib1g sudo \
      ca-certificates curl procps libcap2-bin && rm -rf /var/lib/apt/lists/*
RUN groupadd -r syedge && useradd -r -g syedge -s /usr/sbin/nologin syedge \
 && useradd -r -g syedge -s /usr/sbin/nologin syedge-agent
COPY --from=syedge /out/ /tmp/syedge/
RUN tar -C / -xzf /tmp/syedge/syedge-*.tar.gz && rm -rf /tmp/syedge && ln -s /opt/syedge/sbin/syedge /usr/sbin/syedge
COPY --from=go /out/syedge-agent /usr/bin/syedge-agent
COPY --from=go /out/syedge-wrapper /usr/libexec/syedge/syedge-wrapper
COPY dataplane/packaging/sudoers/syedge-agent /etc/sudoers.d/syedge-agent
# 运行时不使用 root（D5）：wrapper 以 syedge 运行，-t 绑定 80/443 需要文件能力；只允许 syedge 组执行
RUN chown root:syedge /usr/libexec/syedge/syedge-wrapper && chmod 0750 /usr/libexec/syedge/syedge-wrapper \
 && setcap cap_net_bind_service=ip /usr/libexec/syedge/syedge-wrapper
RUN chmod 0440 /etc/sudoers.d/syedge-agent && visudo -c
COPY demo/node/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY demo/node/systemctl /usr/local/bin/systemctl
EXPOSE 80 443
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
