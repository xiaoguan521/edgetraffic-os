# 演示用边缘节点镜像：syapp（从官方源码改名构建）+ syapp-agent + syapp-wrapper
FROM ubuntu:24.04 AS syapp
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git ca-certificates \
      libpcre2-dev libssl-dev zlib1g-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY dataplane dataplane
COPY scripts/rename-scan.sh scripts/rename-scan.sh
COPY docs/NOTICE docs/NOTICE
RUN dataplane/build-syapp.sh -o /out

FROM golang:1.27 AS go
# 仅 CI 端到端测试注入临时授权公钥；正式与演示构建留空
ARG EXTRA_LICENSE_KEY=""
ARG EXTRA_PKG_KEY=""
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -mod=vendor -trimpath -ldflags "-s -w -X github.com/xiaoguan521/edgetraffic-os/internal/license.ciKey=${EXTRA_LICENSE_KEY} -X github.com/xiaoguan521/edgetraffic-os/internal/pkgsig.ciKey=${EXTRA_PKG_KEY}" -o /out/ ./cmd/syapp-agent ./cmd/syapp-wrapper

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends libpcre2-8-0 libssl3t64 zlib1g sudo \
      ca-certificates curl procps && rm -rf /var/lib/apt/lists/*
RUN groupadd -r syapp && useradd -r -g syapp -s /usr/sbin/nologin syapp \
 && useradd -r -g syapp -s /usr/sbin/nologin syapp-agent
COPY --from=syapp /out/ /tmp/syapp/
RUN tar -C / -xzf /tmp/syapp/syapp-*.tar.gz && rm -rf /tmp/syapp && ln -s /opt/syapp/sbin/syapp /usr/sbin/syapp
COPY --from=go /out/syapp-agent /usr/bin/syapp-agent
COPY --from=go /out/syapp-wrapper /usr/libexec/syapp/syapp-wrapper
COPY dataplane/packaging/sudoers/syapp-agent /etc/sudoers.d/syapp-agent
RUN chmod 0440 /etc/sudoers.d/syapp-agent && visudo -c
COPY demo/node/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY demo/node/systemctl /usr/local/bin/systemctl
EXPOSE 80 443
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
