# EdgeTraffic OS 基线（渲染器生成，禁止手改）
{{- if .HasLua }}
# Lua 附加包（{{ brandLua }}）模块，指向与运行中二进制版本匹配的目录
{{ luaLoad . }}
{{- end }}
{{- if .P.User }}
user  {{ .P.Worker }};
{{- end }}
worker_processes  auto;
worker_rlimit_nofile  {{ .P.NoFile }};
pid   {{ .P.PidFile }};
error_log  {{ .P.ErrorLog }}  warn;

events {
    worker_connections  8192;
    multi_accept        on;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    server_tokens  off;
    charset        utf-8;
    sendfile       on;
    tcp_nopush     on;

    log_format  edge_json  escape=json
      '{"ts":"$time_iso8601","rid":"$request_id","site":"$server_name",'
      '"ip":"$remote_addr","method":"$request_method","uri":"$uri",'
      '"status":$status,"bytes":$body_bytes_sent,"rt":$request_time,'
      '"urt":"$upstream_response_time","ua":"$http_user_agent"}';
    access_log  {{ .P.AccessLog }}  edge_json;
{{- if .P.CustomTemp }}

    # 本实例的临时目录（覆盖编译期默认值）
    client_body_temp_path  {{ .P.TempDir }}/client_temp;
    proxy_temp_path        {{ .P.TempDir }}/proxy_temp;
    fastcgi_temp_path      {{ .P.TempDir }}/fastcgi_temp;
    uwsgi_temp_path        {{ .P.TempDir }}/uwsgi_temp;
    scgi_temp_path         {{ .P.TempDir }}/scgi_temp;
{{- end }}

    client_header_timeout  10s;
    client_body_timeout    10s;
    send_timeout           10s;
    keepalive_timeout      15s;
    client_max_body_size   1m;
    large_client_header_buffers  4 8k;

    proxy_http_version     1.1;
    proxy_connect_timeout  3s;
    proxy_read_timeout     30s;
    proxy_send_timeout     30s;
    proxy_hide_header      X-Powered-By;
    proxy_set_header       Host               $host;
    proxy_set_header       X-Real-IP          $remote_addr;
    proxy_set_header       X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header       X-Forwarded-Proto  $scheme;
    proxy_set_header       X-Request-ID       $request_id;

    ssl_protocols        TLSv1.2 TLSv1.3;
    ssl_session_cache    shared:EDGE_SSL:20m;
    ssl_session_timeout  1h;
    ssl_session_tickets  off;

    limit_req_zone   $binary_remote_addr  zone=edge_per_ip:20m  rate=20r/s;
    limit_conn_zone  $binary_remote_addr  zone=edge_conn:20m;
    limit_req_status   429;
    limit_conn_status  429;

{{- if .RealIPFrom }}
    # CDN / LB 回源网段
{{- range .RealIPFrom }}
    set_real_ip_from  {{ . }};
{{- end }}
    real_ip_header     X-Forwarded-For;
    real_ip_recursive  on;
{{- end }}

{{- if .HasRules }}

    # 访问规则不作用于 ACME 验证路径
    map  $uri  $etos_not_acme {
        "~^/\.well-known/acme-challenge/"  0;
        default  1;
    }
{{- end }}
{{- if .HasLua }}
{{ luaHTTP . }}
{{- end }}

    # 未匹配的 Host / SNI 直接断开
    server {
        listen       {{ .P.HTTP }}  default_server;
        server_name  _;
        return       444;
    }
    server {
        listen       {{ .P.HTTPS }}  ssl  default_server;
        server_name  _;
        ssl_reject_handshake  on;
{{- if .HasGM }}
        # 国密握手在 SNI 切换前识别，握手最初落在本 server 上，须同样开启
        ssl_conf_command  Enable_ntls  on;
{{- end }}
    }

    # 仅本机可访问的状态页，供 agent 采集
    server {
        listen       127.0.0.1:{{ .P.Status }};
        server_name  localhost;
        access_log   off;
        location = {{ .P.StatusPath }} {
            stub_status;
        }
        location / {
            return 404;
        }
    }

    include  conf.d/*.conf;
}
{{- if .Streams }}

# 四层代理（P9）
stream {
    include  stream.d/*.conf;
}
{{- end }}
