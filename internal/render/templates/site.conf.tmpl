# site: {{ .Site.Name }}  （渲染器生成，禁止手改）
{{- $s := .Site }}
{{- if .RulesHTTP }}
{{ .RulesHTTP }}
{{- end }}
{{- if and $s.HTTPS $s.ForceHTTPS }}

server {
    listen       {{ $.P.HTTP }};
    server_name  {{ join $s.Domains " " }};
    include  snippets/acme-challenge.conf;
    location / {
        return  301  https://$host$request_uri;
    }
}
{{- end }}

server {
{{- if not (and $s.HTTPS $s.ForceHTTPS) }}
    listen       {{ $.P.HTTP }};
{{- end }}
{{- if $s.HTTPS }}
    listen       {{ $.P.HTTPS }}  ssl;
{{- if $s.HTTP2 }}
    http2        on;
{{- end }}
{{- end }}
    server_name  {{ join $s.Domains " " }};
{{- if $s.HTTPS }}

    ssl_certificate      certs/site-{{ $s.Name }}.crt;
    ssl_certificate_key  certs/site-{{ $s.Name }}.key;
{{- if $s.HTTPS.GM }}

    # 国密 TLCP 双证书（铜锁 NTLS）：国密客户端用 SM2 签名 / 加密证书，其他客户端仍用上面的标准证书。
    # ssl_conf_command 的文件路径不按配置目录解析，因此写本版本目录的绝对路径。
    ssl_ciphers       "ECC-SM2-SM4-GCM-SM3:ECC-SM2-SM4-CBC-SM3:ECDHE-SM2-SM4-GCM-SM3:ECDHE-SM2-SM4-CBC-SM3:HIGH:!aNULL:!MD5";
    ssl_conf_command  Enable_ntls  on;
    ssl_conf_command  SignCertificate  {{ $.P.ReleasesDir }}{{ $.Revision }}/certs/site-{{ $s.Name }}.sm2-sign.crt;
    ssl_conf_command  SignPrivateKey   {{ $.P.ReleasesDir }}{{ $.Revision }}/certs/site-{{ $s.Name }}.sm2-sign.key;
    ssl_conf_command  EncCertificate   {{ $.P.ReleasesDir }}{{ $.Revision }}/certs/site-{{ $s.Name }}.sm2-enc.crt;
    ssl_conf_command  EncPrivateKey    {{ $.P.ReleasesDir }}{{ $.Revision }}/certs/site-{{ $s.Name }}.sm2-enc.key;
{{- end }}
    add_header  Strict-Transport-Security  "max-age=31536000"  always;
{{- end }}

    include  snippets/security.conf;
{{- if $s.ClientMaxBodySize }}
    client_max_body_size  {{ $s.ClientMaxBodySize }};
{{- end }}
{{- if $s.Gzip }}
    gzip  on;
    gzip_min_length  1024;
    gzip_types  text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
{{- end }}
{{- if not (and $s.HTTPS $s.ForceHTTPS) }}
    include  snippets/acme-challenge.conf;
{{- end }}
{{- if .RulesServer }}
{{ .RulesServer }}
{{- end }}
{{- if .AuthLoc }}
{{ .AuthLoc }}
{{- end }}
{{- range $i, $r := .Routes }}

    location {{ if eq $r.Match "exact" }}= {{ end }}{{ $r.Path }} {
{{- if eq $r.Mode "static" }}
{{- if eq $r.Match "exact" }}
        alias         {{ $.P.SitesDir }}{{ $s.Name }}/{{ routeDir $r }}/index.html;
        default_type  text/html;
{{- else }}
        alias  {{ $.P.SitesDir }}{{ $s.Name }}/{{ routeDir $r }}/;
        index  index.html;
{{- if $r.Static.SPA }}
        try_files  $uri  $uri/  {{ $r.Path }}index.html;
{{- end }}
{{- if $r.Static.Files }}
        expires  1h;
        etag     on;
{{- end }}
{{- end }}
{{- else if eq $r.Mode "proxy" }}
        # location 内出现 proxy_set_header 时须重发基线的全部头（规格书 6.3）
        proxy_set_header  Host               $host;
        proxy_set_header  X-Real-IP          $remote_addr;
        proxy_set_header  X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header  X-Forwarded-Proto  $scheme;
        proxy_set_header  X-Request-ID       $request_id;
{{- if $r.Proxy.WebSocket }}
        proxy_http_version  1.1;
        proxy_set_header  Upgrade            $http_upgrade;
        proxy_set_header  Connection         "upgrade";
{{- else }}
        proxy_set_header  Connection         "";
{{- end }}
{{- if gt $r.Proxy.ConnectTimeout 0 }}
        proxy_connect_timeout  {{ $r.Proxy.ConnectTimeout }}s;
{{- end }}
{{- if gt $r.Proxy.ReadTimeout 0 }}
        proxy_read_timeout     {{ $r.Proxy.ReadTimeout }}s;
{{- end }}
{{- if gt $r.Proxy.SendTimeout 0 }}
        proxy_send_timeout     {{ $r.Proxy.SendTimeout }}s;
{{- end }}
{{- if and $r.Proxy.Buffering (not (derefBool $r.Proxy.Buffering)) }}
        proxy_buffering        off;
        proxy_cache            off;
{{- end }}
{{- if $r.Proxy.HTTPS }}
        proxy_ssl_server_name  on;
        proxy_ssl_name         $host;
{{- end }}
        proxy_pass        {{ if $r.Proxy.HTTPS }}https{{ else }}http{{ end }}://up_{{ $r.Proxy.Upstream }}{{ if $r.Proxy.StripPrefix }}/{{ end }};
{{- else if eq $r.Mode "redirect" }}
        return  {{ $r.Redirect.Code }}  {{ $r.Redirect.To }};
{{- else if eq $r.Mode "deny" }}
        return  403;
{{- end }}
{{- if $r.Snippet }}
        # 自定义片段（经审批）
{{ indent $r.Snippet 2 }}
{{- end }}
{{- if $r.LuaScripts }}
        # 自定义 Lua 脚本（经审批，脚本在版本目录 lua/ 中）
{{ luaRoute $s $r }}
{{- end }}
    }
{{- end }}
{{- if $s.ServerSnippet }}

    # 自定义片段（经审批）
{{ indent $s.ServerSnippet 1 }}
{{- end }}
}
