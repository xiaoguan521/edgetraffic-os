# upstreams  （渲染器生成，禁止手改）
{{- range .Upstreams }}

upstream up_{{ .Name }} {
{{- if eq .Algorithm "least_conn" }}
    least_conn;
{{- else if eq .Algorithm "ip_hash" }}
    ip_hash;
{{- end }}
{{- range .Servers }}
    server {{ .Addr }}{{ if gt .Weight 0 }}  weight={{ .Weight }}{{ end }}  max_fails={{ if gt .MaxFails 0 }}{{ .MaxFails }}{{ else }}3{{ end }}  fail_timeout={{ if gt .FailTimeout 0 }}{{ .FailTimeout }}{{ else }}10{{ end }}s{{ if .Backup }}  backup{{ end }}{{ if .Down }}  down{{ end }};
{{- end }}
    keepalive {{ if gt .Keepalive 0 }}{{ .Keepalive }}{{ else }}32{{ end }};
}
{{- end }}
